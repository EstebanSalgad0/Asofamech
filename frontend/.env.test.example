# Copia este archivo como .env.test y ajusta los valores
# Las variables de entorno se pasan al comando de test:
#   E2E_ADMIN_EMAIL=... npm run test:e2e

# URL del frontend (donde corre Vite dev o nginx)
E2E_BASE_URL=http://localhost:3000

# URL del backend FastAPI
E2E_API_BASE=http://localhost:8001

# Credenciales del usuario admin de prueba
# Si la BD está vacía, el primer usuario registrado se auto-aprueba como admin.
# Asegúrate de que este usuario exista antes de correr los tests.
E2E_ADMIN_EMAIL=admin.e2e@asofamech.local
E2E_ADMIN_PASS=Admin12345

# Credenciales del usuario estudiante de prueba
# El global-setup lo registra y aprueba automáticamente usando el admin.
E2E_STUDENT_EMAIL=student.e2e@asofamech.local
E2E_STUDENT_PASS=Student12345
