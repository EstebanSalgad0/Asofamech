# Copia este archivo como .env para ejecuciones locales con Docker.
# NUNCA cometas tokens o secretos reales al repositorio.

# ── SEGURIDAD / JWT ─────────────────────────────────────────────────────────
# Secreto HMAC-SHA256 para firmar tokens JWT. Genera uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Sin esta variable el backend usa un valor inseguro de desarrollo.
ASOFAMECH_JWT_SECRET=cambia-esto-por-un-secreto-seguro

# Tiempo de vida del token de acceso en minutos (default 720 = 12 h).
ASOFAMECH_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Entorno de ejecucion: "development" o "production".
# En produccion, ASOFAMECH_JWT_SECRET es obligatorio (el servidor falla si no se define).
APP_ENV=development

# ── CORS ────────────────────────────────────────────────────────────────────
# Lista de origenes permitidos separados por coma.
# Por defecto: localhost:3000 y localhost:3001 (desarrollo).
#
# Con Cloudflare Tunnel (gestionado automaticamente por start_cloudflare_tunnel.ps1):
#   CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://xxxx.trycloudflare.com
#
# Con dominio propio en produccion:
#   CORS_ORIGINS=http://localhost:3000,https://asofamech.tudominio.cl
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── FRONTEND ────────────────────────────────────────────────────────────────
# En Docker se recomienda dejar FRONTEND_API_BASE vacio. El navegador usa el
# mismo origen y nginx reenvia /api al backend; esto funciona tanto en localhost
# como mediante Cloudflare Tunnel. No uses http://localhost:8001 para acceso
# publico: "localhost" seria el equipo de cada visitante.
FRONTEND_API_BASE=

# Solo para ejecutar Vite directamente fuera de Docker.
VITE_API_BASE=http://localhost:8001

# URL base usada en correos y recuperacion de contrasena. El publicador
# Cloudflare la reemplaza automaticamente por la URL temporal activa.
ASOFAMECH_PLATFORM_URL=http://localhost:3000/auth

# ── BASE DE DATOS ───────────────────────────────────────────────────────────
# PostgreSQL con extension pgvector. En Docker Compose ya esta configurada.
# DATABASE_URL=postgresql://app_user:app_pass@db:5432/app_db

# ── OLLAMA / LLM ────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
# llama3.1:8b es la variante instruct de Llama 3.1 en Ollama (no existe un tag
# "llama3.1:8b-instruct"). Sigue mejor las instrucciones de anclaje a fuentes
# que llama3:8b, que inventaba datos pese a recibir el contexto RAG correcto.
LLM_MODEL=llama3.1:8b

# ── RAG ─────────────────────────────────────────────────────────────────────
# Modelo de embeddings. Debe ser multilingue: el corpus y las consultas estan
# en espanol. Debe entregar 384 dimensiones para calzar con el esquema pgvector.
# Al cambiarlo hay que reindexar el corpus completo (POST /api/rag/reindex).
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Chunking del corpus: 400 tokens conserva el parrafo medico completo y 80 de
# solapamiento evita cortar definiciones o listas a la mitad.
RAG_CHUNK_MAX_TOKENS=400
RAG_CHUNK_OVERLAP_TOKENS=80

# Umbrales minimos de relevancia para incluir fuentes en el contexto del chat.
# 0.42 calibrado sobre el modelo multilingue; el ruido temático que supera este
# score se descarta ademas por el filtro lexico de rag.py.
RAG_MIN_NEURAL_SCORE=0.42
RAG_MIN_LOCAL_SCORE=0.12

# Descarta fuentes por debajo de esta fraccion del mejor resultado. Evita que un
# documento de otro tema entre al contexto solo por superar el umbral absoluto.
RAG_RELATIVE_MARGIN=0.70

# Fragmentos que puede aportar un mismo documento. Con 1, un documento que
# concentra la respuesta la entrega incompleta.
RAG_MAX_CHUNKS_PER_DOCUMENT=3

# Excluye del indice las preguntas de alternativas y sus claves de respuesta,
# para que no se citen como fuente al estudiante.
RAG_EXCLUDE_EVALUATION_ITEMS=true

# ── HISTOPATOLOGIA ──────────────────────────────────────────────────────────
# Token de Hugging Face con acceso aprobado a MahmoodLab/CONCH.
HISTO_HF_TOKEN=hf_your_token_here

# Ruta al checkpoint del clasificador entrenado (opcional si se omite el modulo AI).
# Baseline activo por defecto:
# HISTO_CLASSIFIER_CHECKPOINT=/app/artifacts/histopathology/checkpoints/tri_head_camelyon17_stage16_sane_tuned_v1.pt
# Candidato Stage 17 (activar solo para comparacion controlada):
# HISTO_CLASSIFIER_CHECKPOINT=/app/model_registry/checkpoints/tri_head_stage17_variant_c_augmented.pt
# HISTO_CONCH_CHECKPOINT_REF=MahmoodLab/CONCH

# Umbral de confianza para emitir clasificacion definitiva (0-1).
HISTO_CLASSIFIER_CONFIDENCE_THRESHOLD=0.90

# Umbral binario P(tumor), separado de la confianza multiclase.
# Stage 17 C: HISTO_TUMOR_OPERATING_THRESHOLD=0.35
HISTO_USE_CHECKPOINT_OPERATING_THRESHOLD=false

# Temperature scaling es opt-in porque no mejoro de forma consistente en test.
HISTO_USE_CHECKPOINT_CALIBRATION=false
# HISTO_CLASSIFIER_TEMPERATURE=1.0

# Controles de calidad de ROI.
HISTO_QC_MAX_WHITE_FRACTION=0.45
HISTO_QC_MIN_TISSUE_FRACTION=0.40
HISTO_QC_MIN_NUCLEAR_FRACTION=0.035
HISTO_QC_MAX_STROMA_FRACTION_WHEN_LOW_NUCLEAR=0.65
HISTO_QC_LOW_NUCLEAR_FOR_STROMA_FRACTION=0.12

# Guardar parches de debug en disco (solo desarrollo).
HISTO_SAVE_DEBUG_PATCHES=false

# ── EMAIL (SMTP) ─────────────────────────────────────────────────────────────
# Configuracion para envio de notificaciones por correo.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notificaciones@example.com
# SMTP_PASSWORD=tu_contrasena_smtp
# SMTP_FROM=notificaciones@example.com
# SMTP_TLS=true
