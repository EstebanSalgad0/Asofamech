# Copy this file to .env for local Docker runs.
# Never commit real tokens.

# Hugging Face token with approved access to MahmoodLab/CONCH.
HISTO_HF_TOKEN=hf_your_token_here

# Histopathology inference controls.
HISTO_CLASSIFIER_CONFIDENCE_THRESHOLD=0.90
HISTO_SAVE_DEBUG_PATCHES=true
HISTO_QC_MAX_WHITE_FRACTION=0.45
HISTO_QC_MIN_TISSUE_FRACTION=0.40
HISTO_QC_MIN_NUCLEAR_FRACTION=0.035
HISTO_QC_MAX_STROMA_FRACTION_WHEN_LOW_NUCLEAR=0.65
HISTO_QC_LOW_NUCLEAR_FOR_STROMA_FRACTION=0.12
